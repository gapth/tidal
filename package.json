{
  "name": "tidal",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "build": "npm run build:web",
    "start": "npm run start:web",
    "lint": "npm run lint:web",
    "test": "npm run test:web",
    "dev:web": "dotenv -e .env.local -- npm --workspace @tidal/web run dev",
    "dev:web:prod": "dotenv -e .env -- npm --workspace @tidal/web run dev",
    "build:web": "dotenv -e .env.local -- npm --workspace @tidal/web run build",
    "start:web": "npm --workspace @tidal/web run start",
    "lint:web": "npm --workspace @tidal/web run lint",
    "test:web": "npm --workspace @tidal/web run test",
    "test:web:watch": "npm --workspace @tidal/web run test:watch",
    "dev:worker": "PYTHONPATH=apps/worker:packages/pipeline dotenv -e .env.local -- .venv/bin/uvicorn worker.main:app --port 8080",
    "dev:worker:reload": "PYTHONPATH=apps/worker:packages/pipeline WATCHFILES_FORCE_POLLING=true dotenv -e .env.local -- .venv/bin/uvicorn worker.main:app --reload --reload-dir apps/worker --reload-dir packages/pipeline --port 8080",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": "prettier --write"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3"
  }
}
